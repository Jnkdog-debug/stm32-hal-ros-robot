  58:RobotApp/Src/imu_task.c ****             {
  59:RobotApp/Src/imu_task.c ****                 // A. 读取原始数据 (单位: g, deg/s)
  60:RobotApp/Src/imu_task.c ****                 MPU6050_Read_Accel();
  61:RobotApp/Src/imu_task.c ****                 MPU6050_Read_Gyro(); 
  62:RobotApp/Src/imu_task.c ****                 // MPU6050_Read_Temp(); // 温度不是必须的
  63:RobotApp/Src/imu_task.c **** 
  64:RobotApp/Src/imu_task.c ****                 // B. 处理角速度 (减去零偏 + 转弧度)
  65:RobotApp/Src/imu_task.c ****                 // 1. 减去上电时的静态误差
  66:RobotApp/Src/imu_task.c ****                 float correct_gx = Mpu6050_Data.Gyro_X - gyro_x_offset;
  67:RobotApp/Src/imu_task.c ****                 float correct_gy = Mpu6050_Data.Gyro_Y - gyro_y_offset;
  68:RobotApp/Src/imu_task.c ****                 float correct_gz = Mpu6050_Data.Gyro_Z - gyro_z_offset;
  69:RobotApp/Src/imu_task.c **** 
  70:RobotApp/Src/imu_task.c ****                 // 2. 转换为 rad/s (ROS 标准)
  71:RobotApp/Src/imu_task.c ****                 p_mpu_data->Gyro_X = correct_gx * DEG_TO_RAD;
  72:RobotApp/Src/imu_task.c ****                 p_mpu_data->Gyro_Y = correct_gy * DEG_TO_RAD;
  73:RobotApp/Src/imu_task.c ****                 p_mpu_data->Gyro_Z = correct_gz * DEG_TO_RAD;
  74:RobotApp/Src/imu_task.c **** 
  75:RobotApp/Src/imu_task.c ****                 // C. 处理加速度 (转 m/s^2)
  76:RobotApp/Src/imu_task.c ****                 // 加速度计通常不需要减 offset，因为重力是一直存在的
