  15:RobotApp/Src/motor_task.c **** // ==========================================
  16:RobotApp/Src/motor_task.c **** // 🤖 麦克纳姆轮底盘物理参数
  17:RobotApp/Src/motor_task.c **** // ==========================================
  18:RobotApp/Src/motor_task.c **** // 根据你的 Python 脚本：直径 0.047m
  19:RobotApp/Src/motor_task.c **** #define WHEEL_RADIUS    0.0235f  
  20:RobotApp/Src/motor_task.c **** // 假设轮距与轴距均为 0.15m，因此一半为 0.075m
  21:RobotApp/Src/motor_task.c **** #define HALF_TRACK      0.075f   
  22:RobotApp/Src/motor_task.c **** #define HALF_WHEELBASE  0.075f   
  23:RobotApp/Src/motor_task.c **** // 麦轮几何常数 K = Lx + Ly
  24:RobotApp/Src/motor_task.c **** #define K_FACTOR        (HALF_TRACK + HALF_WHEELBASE)
  25:RobotApp/Src/motor_task.c **** // 将线速度 (m/s) 转换为 RPM 的比例常数
  26:RobotApp/Src/motor_task.c **** // RPM = V / (2 * PI * R) * 60
  27:RobotApp/Src/motor_task.c **** #define VEL_TO_RPM      (60.0f / (2.0f * 3.14159265f * WHEEL_RADIUS))
  28:RobotApp/Src/motor_task.c **** 
  29:RobotApp/Src/motor_task.c **** // 10ms 控制周期 (100Hz)
  30:RobotApp/Src/motor_task.c **** #define MOTOR_CTRL_PERIOD_MS 10
  31:RobotApp/Src/motor_task.c **** 
