  94:RobotApp/Src/motor_task.c ****         float v_fr = vx + vy + wz * K_FACTOR; // Motor_B
  95:RobotApp/Src/motor_task.c ****         float v_rl = vx + vy - wz * K_FACTOR; // Motor_C
  96:RobotApp/Src/motor_task.c ****         float v_rr = vx - vy + wz * K_FACTOR; // Motor_D
  97:RobotApp/Src/motor_task.c **** 
  98:RobotApp/Src/motor_task.c ****         // 转换为目标 RPM
  99:RobotApp/Src/motor_task.c ****         float target_rpm[4];
 100:RobotApp/Src/motor_task.c ****         target_rpm[0] = v_fl * VEL_TO_RPM;
 101:RobotApp/Src/motor_task.c ****         target_rpm[1] = v_fr * VEL_TO_RPM;
 102:RobotApp/Src/motor_task.c ****         target_rpm[2] = v_rl * VEL_TO_RPM;
 103:RobotApp/Src/motor_task.c ****         target_rpm[3] = v_rr * VEL_TO_RPM;
 104:RobotApp/Src/motor_task.c **** 
