  83:RobotApp/Src/motor_task.c ****         osMutexRelease(robotMutexHandle);
  84:RobotApp/Src/motor_task.c **** 
  85:RobotApp/Src/motor_task.c ****         // --- 致命级安全锁：断联看门狗 (Timeout Failsafe) ---
  86:RobotApp/Src/motor_task.c ****         // 如果超过 500ms 没收到香橙派的新指令，强制刹车
  87:RobotApp/Src/motor_task.c ****         if ((xTaskGetTickCount() - last_time) > pdMS_TO_TICKS(500)) {
  88:RobotApp/Src/motor_task.c ****             vx = 0.0f; vy = 0.0f; wz = 0.0f;
